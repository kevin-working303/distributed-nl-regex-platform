# ----------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed. docker-compose reads `.env`.
# ----------------------------------------------------------------------------

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# CORS: comma separated origins the React app is served from.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Fernet key used to encrypt user AWS credentials in transit (Redis/DB).
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left blank, the backend derives one from DJANGO_SECRET_KEY (fine for dev).
CREDENTIALS_ENCRYPTION_KEY=

# --- Postgres (job persistence) ---
POSTGRES_DB=regexdb
POSTGRES_USER=regex
POSTGRES_PASSWORD=regexpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (broker / result backend / cache) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Spark ---
# local[*] runs an in-process cluster using all cores. Point at a standalone
# master (spark://host:7077) to scale out horizontally.
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
# Target rows-per-partition used to size parallelism (see processing/spark_engine.py)
SPARK_ROWS_PER_PARTITION=200000

# --- LLM (Anthropic Claude) ---
# Leave ANTHROPIC_API_KEY blank to run with the deterministic heuristic fallback
# (handles emails, phones, URLs, etc. without any API call).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_CACHE_TTL_SECONDS=86400

# --- Results storage ---
# Shared volume where processed Parquet output is written for paginated reads.
RESULTS_DIR=/data/results

# --- Frontend ---
# Leave BLANK: the SPA then calls relative /api, which nginx (compose) or
# Caddy→nginx (prod) proxies to the backend on the same origin — no CORS needed.
# Only set an absolute backend URL for a separate-origin host (e.g. a PaaS
# static site), which then also requires CORS_ALLOWED_ORIGINS to include it.
VITE_API_BASE_URL=
